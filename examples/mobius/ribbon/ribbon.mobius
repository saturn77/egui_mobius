// The RibbonCitizen milestone — a top command bar in the shape of
// CopperTrace's `citizens/top_ribbon.rs`, declared as source.
//
// Everything here is existing mobius_lang grammar; the ribbon-specific
// vocabulary (`wordmark`, `clock`, `right`, the `top` / `about` layout
// directives) is interpreted by mobius_codegen, not by the parser.

app RibbonDemo {
    enum Theme { CopperDark, TokyoNight, Light }
    enum RibbonCmd { New, Open, Save, Build, Emit }

    // The ribbon's complete boundary: Path A cells plus one Path B edge.
    interface Chrome {
        theme : Theme = Theme::CopperDark
        show_about : bool = false
        clock : string = ""
        actions : signal RibbonCmd
        modport ribbon (write theme, write show_about, read clock, emit actions)
        modport host (read theme, read show_about, write clock, drain actions)
    }

    citizen Ribbon (c : Chrome.ribbon) {
        row {
            wordmark "RibbonDemo";
            separator;
            button "New" -> c.actions(RibbonCmd::New);
            button "Open" -> c.actions(RibbonCmd::Open);
            button "💾 Save" -> c.actions(RibbonCmd::Save);
            separator;
            button "⚙ Build" -> c.actions(RibbonCmd::Build);
            button "⚡ Emit" -> c.actions(RibbonCmd::Emit);
            // Children of `right` read left-to-right as they appear on
            // screen; codegen handles the right_to_left reversal.
            right {
                combo "🎨" -- c.theme;
                button "ℹ About" -- c.show_about;
                separator;
                clock -- c.clock;
            }
        }
    }

    @wiring {
        let chrome = Chrome();
        let ribbon = Ribbon(c = chrome.ribbon);
    }

    @layout {
        top(ribbon);
        about(trigger = chrome.show_about,
              title   = "RibbonDemo",
              tagline = "A ribbon citizen generated by mobius_codegen.",
              image   = "assets/about.png",
              deps    = true,
              resizable = true);
    }
}
