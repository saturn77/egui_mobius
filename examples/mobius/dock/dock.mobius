// Build:  cargo run -p mobius_codegen --bin mobius-gen -- examples/mobius/dock/dock.mobius
// Run:    cd examples/mobius/dock/generated && cargo run
//
// Output location and dependency roots come from ./mobius.toml; the
// generated project is standalone — yours to edit, no tie to the
// generator.
//
// The second-citizen milestone — a complete Level-1 app shape: themed
// ribbon on top, a docked two-channel panel layout, and the System
// logger (egui_lens) along the bottom.
//
// The honest test of citizen-as-module: the SAME citizen declarations
// (`Controls`, `Scope`) instantiated twice, each pair wired to its own
// instance of the SAME interface (`Channel`) — declaration vs instance,
// exactly like instantiating a Verilog module twice with different port
// bindings. Each instance gets its own CitizenId and dock tab.
//
// `LoggerState` / `LogColors` are builtin prefab types (egui_lens); the
// `logger` primitive renders the reactive event log, and the generated
// app logs the startup banner — version, dependencies, system details —
// the way CopperForge does.

app DockDemo {
    enum Theme { CopperDark, TokyoNight, Light }

    // Modport verbs are access rights from the citizen's seat: `write`
    // = this side's hand is on the pen (the theme combo and About
    // button live in the ribbon, so the ribbon writes those cells —
    // writing implies reading); `read` = observe only (the host stamps
    // the clock; the ribbon displays it). The two modports mirror
    // exactly — every cell has one writer, which is what makes the
    // one-writer check possible. (SystemVerilog spellings `out`/`in`
    // are accepted synonyms.)
    interface Chrome {
        theme : Theme = Theme::CopperDark
        show_about : bool = false
        clock : string = ""
        modport ribbon (write theme, write show_about, read clock)
        modport host (read theme, read show_about, write clock)
    }

    interface Channel {
        level : f32 = 0.5
        modport ctrl (write level)
        modport view (read level)
    }

    interface Log {
        state : LoggerState
        colors : LogColors
        modport view (read state, read colors)
        modport host (write state, write colors)
    }

    // Example 1's chrome essentials — wordmark, theme, About/version,
    // clock — without the file group.
    citizen Ribbon (c : Chrome.ribbon) {
        row {
            wordmark "DockDemo";
            separator;
            right {
                combo "🎨" -- c.theme;
                button "ℹ About" -- c.show_about;
                separator;
                clock -- c.clock;
            }
        }
    }

    citizen Controls (c : Channel.ctrl) {
        column {
            slider "Level" 0.0..1.0 -- c.level;
        }
    }

    citizen Scope (s : Channel.view) {
        column {
            label -- s.level;
        }
    }

    citizen System (l : Log.view) {
        logger -- l.state;
    }

    @wiring {
        let chrome = Chrome();
        let ch0 = Channel();
        let ch1 = Channel();
        let log = Log();
        let ribbon = Ribbon(c = chrome.ribbon);
        let controls0 = Controls(c = ch0.ctrl);
        let controls1 = Controls(c = ch1.ctrl);
        let scope0 = Scope(s = ch0.view);
        let scope1 = Scope(s = ch1.view);
        let system = System(l = log.view);
    }

    @layout {
        top(ribbon);
        about(trigger = chrome.show_about,
              title   = "DockDemo",
              tagline = "Example 2 of the .mobius tutorial — the egui_lens System citizen (logger prefab), docked panels, and the same citizen instantiated twice.",
              deps    = true,
              resizable = true);
        dock(controls0, region = left);
        dock(controls1, region = left);
        dock(scope0, region = center);
        dock(scope1, region = center);
        dock(system, region = bottom);
    }
}
