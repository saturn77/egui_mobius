{
  "name": "mobius-lang",
  "displayName": "mobius-lang (.mobius)",
  "description": "Syntax highlighting for egui_mobius .mobius composition files.",
  "version": "0.1.0",
  "publisher": "atlantix-eda",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mobius",
        "aliases": [
          "mobius-lang",
          "mobius"
        ],
        "extensions": [
          ".mobius"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mobius",
        "scopeName": "source.mobius",
        "path": "./syntaxes/mobius.tmLanguage.json"
      }
    ]
  }
}
